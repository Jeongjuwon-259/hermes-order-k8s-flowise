# Garmin Connect MCP Server — Dockerfile ( 빌드용 )
# 사용법: docker build -t garmin-mcp:latest .

FROM python:3.12-slim

WORKDIR /app

# uv 설치
RUN pip install --no-cache-dir uv

# pyproject.toml 없이 PyPI에서 직접 설치
RUN uv pip install --system garmin-mcp

ENV GARMIN_TOKEN_DIR=/root/.garminconnect

ENTRYPOINT ["garmin-mcp"]
CMD ["--transport", "stdio"]
