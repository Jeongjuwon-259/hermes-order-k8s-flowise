# 5-gitops/argocd-defaults/ — Dockerfile 표준 템플릿
# 사용법: docker build -t <image-name>:latest -f <Dockerfile_path> .
# 사용예: docker build -t garmin-mcp:latest -f 5-gitops/argocd-defaults/Dockerfile_garmin_mcp .

# 표준 구조:
# 1. FROM <base-image>
# 2. COPY <의존성 파일> ./
# 3. RUN <설치>
# 4. COPY . .
# 5. ENTRYPOINT / CMD
