# Garmin Connect MCP Server — Dockerfile
# 소스: https://github.com/Jeongjuwon-259/hermes-garmin-connect-mcp (README.md 기준, 2026-09-23 갱신)
# 사용법: docker build -t garmin_mcp:latest -f Dockerfile_garmin_mcp .
#
# K8s/컨테이너 배포는 stdio가 아니라 garmin-mcp-http(streamable-http) 진입점을 쓴다.
# (Claude Desktop 로컬 실행용 garmin-mcp(stdio)는 여기서 안 씀 — README.md "원격 실행" 참고)

FROM python:3.12-slim

# UV 사용 (pip보다 빠름, pyproject.toml/uv.lock과 호환)
RUN pip install --no-cache-dir uv

WORKDIR /app

# 의존성 정의만 먼저 복사 (레이어 캐시 활용)
COPY pyproject.toml uv.lock ./

# 소스 전체 복사 (hatchling 빌드가 src/garmin_mcp를 참조)
COPY . .

# lock 파일 기준으로 설치 (hatchling 빌드 시스템, pyproject.toml [project.scripts] 기준
# garmin-mcp-http 콘솔 스크립트까지 함께 설치됨)
RUN uv sync --frozen --no-dev

ENV PATH="/app/.venv/bin:${PATH}"

# Garmin Connect 인증 토큰 저장 경로 (README.md "환경 변수" 참고, 실제 토큰은
# K8s Secret(GARMINTOKENS, base64) 또는 SealedSecret으로 주입 — 이미지엔 안 넣음)
ENV GARMIN_TOKEN_DIR=/root/.garminconnect

# http_main.py 기본값과 동일 (README.md "원격 실행" 표 참고)
ENV MCP_HOST=0.0.0.0
ENV MCP_PORT=8000

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=2)" || exit 1

ENTRYPOINT ["garmin-mcp-http"]
