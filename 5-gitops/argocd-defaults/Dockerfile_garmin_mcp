# Garmin Connect MCP Server — Dockerfile
# 실제 소스: https://github.com/Jeongjuwon-259/hermes-garmin-connect-mcp.git
# (소스코드는 이 레포가 아니라 위 레포에서 관리됨 — 여기서는 git clone으로 받아 빌드만 한다)
#
# 사용법: docker build -t garmin_mcp:latest -f Dockerfile_garmin_mcp .
#
# K8s/컨테이너 배포는 stdio가 아니라 garmin-mcp-http(streamable-http) 진입점을 쓴다.
# (Claude Desktop 로컬 실행용 garmin-mcp(stdio)는 여기서 안 씀 — 실제 레포 README "원격 실행" 참고)

FROM python:3.12-slim

ARG GARMIN_MCP_REPO=https://github.com/Jeongjuwon-259/hermes-garmin-connect-mcp.git
ARG GARMIN_MCP_REF=main

RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir uv

WORKDIR /app

# 실제 소스 레포를 직접 clone (private repo이므로 GitHub PAT 필요).
# BuildKit --secret으로 주입한다. 토큰을 URL에 넣으면 clone이 그 URL을 .git/config의 remote.origin.url에
# 저장해서 /app/.git/config로 이미지에 남는다 (2026-10 실측: kubectl exec로 확인됨).
# 그래서 토큰은 URL이 아니라 `git -c http.extraHeader`(해당 명령 한 번에만 적용, config에 저장 안 됨)로 넘기고,
# 빌드에 필요 없는 .git은 지운다.
# 빌드 명령: docker build --secret id=github_pat,env=GITHUB_PAT -t garmin_mcp:latest -f Dockerfile_garmin_mcp .
RUN --mount=type=secret,id=github_pat \
    AUTH="$(printf 'x-access-token:%s' "$(cat /run/secrets/github_pat)" | base64 -w0)" \
    && git -c "http.extraHeader=Authorization: Basic ${AUTH}" clone \
       --branch "${GARMIN_MCP_REF}" --depth 1 "${GARMIN_MCP_REPO}" . \
    && rm -rf .git

# 소스 레포가 uv.lock을 git에 커밋하지 않으므로(.gitignore 대상) --frozen 불가.
# 매 빌드마다 lock을 새로 계산 (hatchling 빌드 시스템, pyproject.toml [project.scripts] 기준
# garmin-mcp-http 콘솔 스크립트까지 함께 설치됨)
RUN uv sync --no-dev

ENV PATH="/app/.venv/bin:${PATH}"

# Garmin Connect 인증 토큰 저장 경로. 실제 토큰은 SealedSecret(garmin-mcp-secret)으로 주입 — 이미지엔 안 넣음:
#   GARMINTOKENS    = garmin_tokens.json의 "원본 JSON 문자열" (Base64 아님 — Base64는 조용히 무시됨)
#   MCP_AUTH_TOKENS = /mcp Bearer 토큰 (필수 — 없으면 garmin-mcp-http가 기동을 거부함)
ENV GARMIN_TOKEN_DIR=/root/.garminconnect

ENV MCP_HOST=0.0.0.0
ENV MCP_PORT=8000

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=2)" || exit 1

ENTRYPOINT ["garmin-mcp-http"]
