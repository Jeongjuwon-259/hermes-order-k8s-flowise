# gamin MCP Server — Dockerfile
# 사용법: docker build -t gamin:latest .

FROM python:3.12-slim

# UV 사용 (pip보다 빠름, pyproject.toml과 호환)
RUN pip install --no-cache-dir uv

WORKDIR /app

# 의존성만 먼저 복사 (레이어 캐시 활용)
COPY pyproject.toml ./

# hatchling 빌드 시스템 + editable 설치 (pyproject.toml 호환)
RUN uv pip install --system -e .

# 소스 전체 복사
COPY . .

# gamin 인증 정보 (도커 환경용 Base64 토큰 지원)
ENV GARMIN_TOKEN_DIR=/root/.garminconnect

ENTRYPOINT ["gamin"]
CMD ["--transport", "stdio"]
